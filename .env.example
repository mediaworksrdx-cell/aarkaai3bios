# ─── AARKAAI Backend – Environment Configuration Template ─────────────────────
# Copy this file to .env and replace ALL values with your actual credentials.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Environment ─────────────────────────────────────────────────────────────
AARKAAI_ENV=development
AARKAAI_HOST=0.0.0.0
AARKAAI_PORT=5000
AARKAAI_LOG_LEVEL=INFO
AARKAAI_WORKERS=1

# ─── Security & Authentication ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AARKAAI_SECRET_KEY=REPLACE_ME_generate_with_secrets_token_urlsafe_64
AARKAAI_ACCESS_TOKEN_MINUTES=30
AARKAAI_REFRESH_TOKEN_DAYS=30
AARKAAI_API_KEY=

# ─── Base URL ────────────────────────────────────────────────────────────────
AARKAAI_BASE_URL=http://localhost:5000

# ─── Database (SQLAlchemy) ───────────────────────────────────────────────────
# SQLite (development):
# AARKAAI_DB_URL=sqlite:///aarkaai.db
# PostgreSQL (production):
# AARKAAI_DB_URL=postgresql://user:password@host:5432/aarkaai

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
MONGODB_URI=REPLACE_ME_mongodb_atlas_connection_string
MONGODB_DB_NAME=aarkaai

# ─── Redis (Optional – used for rate limiting, caching, token revocation) ────
REDIS_URL=redis://localhost:6379/0

# ─── Vertex AI / GCP ────────────────────────────────────────────────────────
# Path to your GCP service account JSON key (do NOT commit the key file)
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT=REPLACE_ME_gcp_project_id
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# ─── External AI Providers ──────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_ME_gemini_api_key
CLAUDE_API_KEY=REPLACE_ME_anthropic_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ─── OAuth (GitHub) ─────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=REPLACE_ME_github_oauth_client_id
GITHUB_CLIENT_SECRET=REPLACE_ME_github_oauth_client_secret

# ─── OAuth (Google) ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME_google_oauth_client_id
GOOGLE_CLIENT_SECRET=REPLACE_ME_google_oauth_client_secret

# ─── Google Custom Search Engine ─────────────────────────────────────────────
GOOGLE_CSE_API_KEY=REPLACE_ME_google_cse_api_key
GOOGLE_CSE_ID=REPLACE_ME_google_cse_id

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcards in production)
AARKAAI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ─── Rate Limiting ──────────────────────────────────────────────────────────
AARKAAI_RATE_LIMIT_RPM=30
AARKAAI_RATE_LIMIT_ENABLED=false

# ─── Input Validation ───────────────────────────────────────────────────────
AARKAAI_MAX_QUERY_LENGTH=32000
AARKAAI_MAX_TOKENS=1536
AARKAAI_MAX_UPLOAD_SIZE_MB=10

# ─── RAG Configuration ──────────────────────────────────────────────────────
AARKAAI_RAG_SIM_THRESHOLD=0.50
AARKAAI_RAG_RERANK_THRESHOLD=0.25
AARKAAI_RAG_MAX_CHARS=1500
AARKAAI_RAG_POOL_SIZE=10

# ─── BashTool Execution ─────────────────────────────────────────────────────
AARKAAI_BASH_TIMEOUT=30.0

# ─── Payments (Razorpay) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=REPLACE_ME_razorpay_key_id
RAZORPAY_KEY_SECRET=REPLACE_ME_razorpay_key_secret

# ─── Push Notifications (VAPID) ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=REPLACE_ME_vapid_public_key
VAPID_PRIVATE_KEY=REPLACE_ME_vapid_private_key
VAPID_CLAIMS_EMAIL=REPLACE_ME_admin_email

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=REPLACE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=REPLACE_ME_smtp_user
SMTP_PASSWORD=REPLACE_ME_smtp_password
