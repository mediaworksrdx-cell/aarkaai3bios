# AARKAAI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Core Environment ────────────────────────────────────────────────────────
# "development" or "production"
AARKAAI_ENV=development

# Server bind address and port
AARKAAI_HOST=0.0.0.0
AARKAAI_PORT=5000

# Log level: DEBUG | INFO | WARNING | ERROR
AARKAAI_LOG_LEVEL=INFO

# Number of uvicorn worker processes (1 recommended for local inference)
AARKAAI_WORKERS=1

# ─── Security & Authentication ───────────────────────────────────────────────
# REQUIRED in production. Minimum 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AARKAAI_SECRET_KEY=change-me-use-a-strong-random-secret-key-minimum-32-chars

# JWT access token lifetime in minutes (default: 10080 = 7 days)
AARKAAI_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Global API key for all endpoints (empty = no global key auth in dev)
AARKAAI_API_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default for development)
AARKAAI_DB_URL=sqlite:///./aarkaai.db

# MongoDB (optional — if set, MongoDB is used instead of SQLite for user/conversation data)
MONGODB_URI=
MONGODB_DB_NAME=aarkaai

# ─── OAuth — GitHub ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── OAuth — Google ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL for OAuth redirect URIs (must match what's registered in Google/GitHub console)
AARKAAI_OAUTH_REDIRECT_URL=http://localhost:5000

# ─── External AI Providers ───────────────────────────────────────────────────
# Vertex AI / Gemini (for external agent mode via model_override=gemini-*)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (for model_override=claude-*)
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ─── Web Search ──────────────────────────────────────────────────────────────
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
TAVILY_API_KEY=

# ─── Finance Data ────────────────────────────────────────────────────────────
TWELVE_DATA_API_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (empty = allow all in dev, required in prod)
AARKAAI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────────────────────
AARKAAI_RATE_LIMIT_RPM=30
AARKAAI_RATE_LIMIT_ENABLED=false

# ─── Generation Limits ───────────────────────────────────────────────────────
AARKAAI_MAX_QUERY_LENGTH=32000
AARKAAI_MAX_TOKENS=16384
AARKAAI_TEMPERATURE=0.7
AARKAAI_MODEL_CONTEXT_WINDOW=16384
AARKAAI_CONTEXT_BUDGET=8000
AARKAAI_MAX_HISTORY_CHARS=6000

# ─── Response Cache ──────────────────────────────────────────────────────────
AARKAAI_RESPONSE_CACHE_TTL=60

# ─── Verifier Agent ──────────────────────────────────────────────────────────
AARKAAI_VERIFIER_ENABLED=false

# ─── RAG ─────────────────────────────────────────────────────────────────────
AARKAAI_RAG_SIM_THRESHOLD=0.50
AARKAAI_RAG_RERANK_THRESHOLD=0.25
AARKAAI_RAG_MAX_CHARS=6000
AARKAAI_RAG_POOL_SIZE=10
AARKAAI_RAG_KW_OVERLAP=0.10
AARKAAI_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
AARKAAI_CHROMA_DIR=./chroma_db

# ─── Knowledge-First Fast Path (Beta) ────────────────────────────────────────
AARKAAI_KNOWLEDGE_FIRST_ENABLED=false
AARKAAI_KNOWLEDGE_FIRST_THRESHOLD=0.75
AARKAAI_KNOWLEDGE_FIRST_HISTORY_KEEPALIVE=5

# ─── Hybrid Query Router (Beta) ──────────────────────────────────────────────
AARKAAI_HQR_ENABLED=false
AARKAAI_HQR_MAX_WORKERS=6
AARKAAI_HQR_MARKET_TIMEOUT=8.0
AARKAAI_HQR_WEB_TIMEOUT=8.0
AARKAAI_HQR_NEWS_TIMEOUT=6.0
AARKAAI_HQR_DB_TIMEOUT=3.0
AARKAAI_HQR_RAG_TIMEOUT=8.0
AARKAAI_HQR_TOOL_TIMEOUT=10.0
AARKAAI_HQR_CONTEXT_BUDGET=24000
AARKAAI_HQR_PARALLEL=true
AARKAAI_HQR_BYPASS_THRESHOLD=0.92

# ─── Freemium / Subscription ─────────────────────────────────────────────────
AARKAAI_FREE_STRATEGY_LIMIT=15
AARKAAI_FREE_RESET_HOURS=5

# ─── Agent Tools ─────────────────────────────────────────────────────────────
AARKAAI_BASH_TIMEOUT=30.0

# ─── File Upload ─────────────────────────────────────────────────────────────
AARKAAI_MAX_UPLOAD_SIZE_MB=10

# ─── Modal Serverless GPU (optional) ─────────────────────────────────────────
MODAL_GPU_ENABLED=false
MODAL_GPU_ENDPOINT=https://your-modal-endpoint.modal.run

# ─── Context Compaction ──────────────────────────────────────────────────────
AARKAAI_COMPACTION_ENABLED=true
AARKAAI_COMPACTION_TRIGGER=0.80
AARKAAI_COMPACTION_PRESERVE_TURNS=3
AARKAAI_RESERVED_OUTPUT_TOKENS=2048

# ─── KV-Cache Prefix Stability ───────────────────────────────────────────────
AARKAAI_KV_PREFIX_CACHE=true
AARKAAI_KV_CACHE_DIAGNOSTICS=false

# ─── Code Mode ───────────────────────────────────────────────────────────────
AARKAAI_CODE_MODE_TIMEOUT=30.0
AARKAAI_CODE_MODE_MAX_CALLS=15
AARKAAI_CODE_MODE_SANDBOX=docker
AARKAAI_CODE_MODE_MAX_OUTPUT=1048576
AARKAAI_CODE_MODE_MAX_MEMORY=512
AARKAAI_CODE_MODE_IMAGE=aarkaa-sandbox:3.11.8-hardened

# ─── MCP ─────────────────────────────────────────────────────────────────────
AARKAAI_MCP_CONFIG=./mcp_config.yaml

# ─── Auto-Learning ───────────────────────────────────────────────────────────
AARKAAI_AUTO_LEARN_MIN_RESPONSE_CHARS=200
AARKAAI_AUTO_LEARN_MIN_CONFIDENCE=0.70

# ─── Confidence & Thresholds ─────────────────────────────────────────────────
AARKAAI_CONFIDENCE_THRESHOLD=0.85

# ─── Autonomous Planning ─────────────────────────────────────────────────────
ENABLE_AUTONOMOUS_PLANNING=true
