# .env.production.template
# DO NOT COMMIT REAL CREDENTIALS
# Copy to .env on the production host or inject via Secret Manager / CI secrets

# ─── JWT & Session Signing ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
AARKAAI_SECRET_KEY=YOUR_SECURE_64_BYTE_HEX_KEY_HERE
AARKAAI_ACCESS_TOKEN_MINUTES=30
AARKAAI_REFRESH_TOKEN_DAYS=30

# ─── Database ────────────────────────────────────────────────────────────────
# Production MongoDB Atlas URI (URL-encode special characters in password)
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aarkaai
DATABASE_URL=sqlite:///aarkaai.db

# ─── Redis Cache & Token Revocation ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── OAuth Providers ─────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=YOUR_ROTATED_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_ROTATED_GITHUB_CLIENT_SECRET
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
OAUTH_REDIRECT_BASE_URL=https://synthetixanalytics.com

# ─── Google Cloud & Vertex AI ────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/etc/aarkaai/secrets/gcp-sa-key.json
VERTEX_PROJECT=orbital-heaven-504004-s2
VERTEX_LOCATION=us-central1
GOOGLE_CSE_API_KEY=YOUR_ROTATED_GOOGLE_CSE_API_KEY
GOOGLE_CSE_ID=YOUR_GOOGLE_CSE_ID

# ─── Service Gateway & API Keys ──────────────────────────────────────────────
AARKAAI_API_KEY=YOUR_SERVICE_API_KEY
PORT=5000
ENVIRONMENT=production
AARKAAI_ENV=production
