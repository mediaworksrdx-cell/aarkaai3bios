{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "typeRoots": [
      "../frontend/node_modules/@types"
    ]
  },
  "include": [
    "lib/**/*.ts",
    "types.d.ts"
  ]
}
