<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for AARKAAI.
  Production uses HTTPS (aarka-ai.com) — no cleartext exceptions needed.
  Only emulator loopback (10.0.2.2) allowed over HTTP for local dev.
-->
<network-security-config>
    <!-- Default: require HTTPS for all domains -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Exception: allow HTTP only for Android emulator local dev -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain> <!-- Android emulator loopback -->
    </domain-config>
</network-security-config>
